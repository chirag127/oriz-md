---
import Base from '../layouts/Base.astro'
import Studio from '../components/Studio.tsx'
---

<Base>
  <section class="md-hero">
    <p class="md-hero__eyebrow">md.oriz.in · markdown studio</p>
    <h1 class="md-hero__title">Markdown editor. <em>Write calm, read light.</em></h1>
    <p class="md-hero__lede">
      A free split-screen editor for GitHub-Flavored Markdown — live preview, syntax highlighting,
      auto table of contents, HTML export and print-to-PDF. All in your browser.
    </p>
    <a class="md-hero__cta" href="#studio">Start writing ↓</a>
    <p class="md-hero__meta">
      <span>no upload</span> · <span>no signup</span> · <span>autosaves locally</span>
    </p>
  </section>

  <Studio client:load />
</Base>
